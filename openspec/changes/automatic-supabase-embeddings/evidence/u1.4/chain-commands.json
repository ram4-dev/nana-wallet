    "stdin_sql": "DO $proof$ BEGIN\nIF EXISTS (SELECT FROM embedding_private.control WHERE activated OR claims_enabled OR semantic_enabled) OR (SELECT count(*) FROM embedding_private.control)<>1 THEN RAISE EXCEPTION 'control'; END IF;\nIF EXISTS (SELECT FROM embedding_private.jobs) THEN RAISE EXCEPTION 'jobs'; END IF;\nIF (SELECT count(*) FROM information_schema.columns WHERE table_schema='public' AND table_name IN ('recipients','user_memories') AND column_name IN ('embedding','embedding_model_revision') AND is_nullable='YES')<>4 THEN RAISE EXCEPTION 'nullable'; END IF;\nIF (SELECT count(*) FROM pg_class WHERE oid IN ('public.recipients'::regclass,'public.user_memories'::regclass) AND relrowsecurity AND relforcerowsecurity)<>2 THEN RAISE EXCEPTION 'RLS'; END IF;\nIF (SELECT count(*) FROM pg_trigger WHERE tgrelid IN ('public.recipients'::regclass,'public.user_memories'::regclass) AND NOT tgisinternal AND tgenabled='O')<>4 THEN RAISE EXCEPTION 'triggers'; END IF;\nIF NOT has_table_privilege('recipient_app','public.recipients','INSERT') OR NOT has_table_privilege('recipient_app','public.user_memories','INSERT') OR NOT has_table_privilege('recipient_app','public.recipients','UPDATE') OR NOT has_table_privilege('recipient_app','public.user_memories','UPDATE') THEN RAISE EXCEPTION 'dormant grants'; END IF;\nIF has_schema_privilege('recipient_app','embedding_private','USAGE') OR has_function_privilege('recipient_app','embedding_private.activate()','EXECUTE') THEN RAISE EXCEPTION 'private'; END IF;\nIF (SELECT prosecdef OR proconfig IS DISTINCT FROM ARRAY['search_path=pg_catalog, extensions','row_security=off'] FROM pg_proc WHERE oid='embedding_private.activate()'::regprocedure) THEN RAISE EXCEPTION 'activation config'; END IF;\nIF EXISTS (SELECT FROM pg_proc p,LATERAL aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a WHERE p.oid='embedding_private.activate()'::regprocedure AND a.grantee=0) THEN RAISE EXCEPTION 'PUBLIC execute'; END IF;\nIF (SELECT n.nspname FROM pg_extension e JOIN pg_namespace n ON n.oid=e.extnamespace WHERE e.extname='vector')<>'extensions' THEN RAISE EXCEPTION 'vector namespace'; END IF;\nEND $proof$;\nSELECT version();\nSELECT 'proof passed: supabase,22 migrations,4 nullable fields,4 guards,RLS forced,grants dormant,activation private and disabled';\nSHOW search_path;\n"
  },
