        "stdin": "SHOW search_path;\nSELECT version();\nSELECT n.nspname AS vector_schema FROM pg_extension e JOIN pg_namespace n ON n.oid=e.extnamespace WHERE e.extname='vector';\nSELECT activated,claims_enabled,semantic_enabled FROM embedding_private.control;\nSELECT count(*) AS jobs FROM embedding_private.jobs;\nSELECT count(*) AS source_triggers FROM pg_trigger WHERE tgrelid IN ('recipients'::regclass,'user_memories'::regclass) AND NOT tgisinternal;\nSELECT proname,prosecdef,proconfig FROM pg_proc WHERE pronamespace='embedding_private'::regnamespace ORDER BY proname;\nDO $assert$ BEGIN\nIF current_setting('search_path') <> '\"$user\", public' OR EXISTS(SELECT FROM embedding_private.control WHERE activated OR claims_enabled OR semantic_enabled)\n OR EXISTS(SELECT FROM embedding_private.jobs) OR (SELECT count(*) FROM pg_trigger WHERE tgrelid IN ('recipients'::regclass,'user_memories'::regclass) AND NOT tgisinternal)<>4\n OR (SELECT count(*) FROM information_schema.columns WHERE table_schema='public' AND table_name IN ('recipients','user_memories') AND column_name IN ('embedding','embedding_model_revision') AND is_nullable='NO')<>4\n OR EXISTS(SELECT FROM pg_proc WHERE pronamespace='embedding_private'::regnamespace AND (NOT prosecdef OR proconfig<>ARRAY['search_path=pg_catalog, extensions'])) THEN\n RAISE EXCEPTION 'U1.3 full chain invariant failed'; END IF; END $assert$;",
