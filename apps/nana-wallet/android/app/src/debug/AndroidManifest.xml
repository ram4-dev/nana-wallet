<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: allow cleartext traffic so the device app can reach the
  local backend and dev server over plain http during development.

  Android blocks cleartext by default for targetSdk >= 28 and Capacitor 8 does not
  apply `server.cleartext` on Android. Release builds are unaffected.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
