VITE_API_URL=http://localhost:3000
VITE_AGENT_BACKEND=1
# Development-only LiveKit Cloud token server ID.
VITE_LIVEKIT_TOKEN_SERVER_ID=
VITE_LIVEKIT_AGENT_NAME=nani-agent
VITE_LIVEKIT_PARTICIPANT_IDENTITY=11111111-1111-4111-8111-111111111111
# LiveKit Cloud returns a short-lived room token at runtime. Never place API
# secrets or binding private keys in VITE_* values.
