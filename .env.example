# Model provider (OpenCode Go)
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4-flash

# WDK demo configuration
WDK_WALLET_NAME=agent-demo
WDK_NETWORK=sepolia
WDK_TOKEN=USDT

# fixture | live — fixture is safe/default; live starts the bundled wdk-mcp process
WDK_TOOLS_SOURCE=fixture

PORT=3000

# Recipient address memory — disabled by default. Set all required values before enabling.
RECIPIENT_MEMORY_ENABLED=false
# App runtime uses the restricted role; admin URL is migration-only.
# DATABASE_URL=postgresql://recipient_app@127.0.0.1:5432/wdk_agent
# DATABASE_ADMIN_URL=postgresql://postgres@127.0.0.1:5432/wdk_agent
# Fixed demo tenant only; production must inject an authenticated principal instead.
# DEMO_USER_ID=11111111-1111-4111-8111-111111111111
RECIPIENT_MEMORY_MODEL_CACHE=.cache/recipient-memory-model
RECIPIENT_MEMORY_SCORE_THRESHOLD=0.78
RECIPIENT_MEMORY_SCORE_MARGIN=0.08
# JSON containing only records/facts already explicitly confirmed by the user.
# RECIPIENT_MEMORY_SEED_FILE=examples/recipient-memory.seed.json
RECIPIENT_MEMORY_SEED_FILE=
