# Model provider (OpenCode Go)
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4-flash

# WDK demo configuration
WDK_WALLET_NAME=agent-demo
WDK_NETWORK=sepolia
WDK_TOKEN=USDT
# Optional for transfers; required for indexed history in live mode.
WDK_INDEXER_API_KEY=

# fixture | live — fixture is safe/default; live starts the bundled wdk-mcp process
WDK_TOOLS_SOURCE=fixture

# Required in live mode. Transfers fail closed if either policy value is absent or invalid.
# Use a positive plain-decimal cap and a comma-separated EVM recipient allowlist.
# WDK_MAX_TRANSFER_AMOUNT=0.05
# WDK_ALLOWED_RECIPIENTS=0x1111111111111111111111111111111111111111

# Optional. Live transfers poll this Sepolia JSON-RPC endpoint until the receipt is mined.
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# llm is the default conversational path (ToolLoopAgent). Set deterministic only for parser-only E2E.
AGENT_RUNTIME=llm

# comma-separated browser origins allowed for CORS
# CORS_ORIGINS=http://localhost:8083,http://127.0.0.1:8083

HOST=127.0.0.1
PORT=3000

# Speech-to-text (Whisper large-v3 via NaN Builders, https://nan.builders/docs)
NAN_API_KEY=
NAN_STT_MODEL=whisper

# Text-to-speech (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# Recipient address memory — disabled by default. Set all required values before enabling.
RECIPIENT_MEMORY_ENABLED=false
# Supabase local PostgreSQL. The application always uses the restricted role.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Fixed demo tenant only; production must inject an authenticated principal instead.
DEMO_USER_ID=11111111-1111-4111-8111-111111111111
RECIPIENT_MEMORY_MODEL_CACHE=.cache/recipient-memory-model
RECIPIENT_MEMORY_SCORE_THRESHOLD=0.78
RECIPIENT_MEMORY_SCORE_MARGIN=0.08
# JSON containing only records/facts already explicitly confirmed by the user.
# RECIPIENT_MEMORY_SEED_FILE=examples/recipient-memory.seed.json
RECIPIENT_MEMORY_SEED_FILE=

# LiveKit development worker and Fastify binding trust boundary.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVE_VOICE_BINDING_PRIVATE_KEY=
LIVE_VOICE_BINDING_PUBLIC_KEY=
LIVEKIT_SHUTDOWN_TIMEOUT_MS=10000
# Privacy guardrails. These values must stay false in the development room.
LIVEKIT_RECORDING_ENABLED=false
AGENT_OBSERVABILITY_RECORDING=false
# Fastify signs bindings with the private key; only the worker receives the public key.
# Generate an environment-specific Ed25519 pair outside the repository.
LIVE_VOICE_ENABLED=false
# LIVE_VOICE_BINDING_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# LIVE_VOICE_BINDING_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# Worker-only values. The worker refuses to start without these values.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_AGENT_NAME=nani
# Explicit wallet-free Cloud smoke inputs; never use a wallet broadcast gate here.
# LIVEKIT_E2E_AGENT_NAME=nani
# LIVEKIT_E2E_BINDING_TOKEN=
# LIVEKIT_E2E_BINDING_PUBLIC_KEY=
# Live voice traces are disabled unless explicitly opted in.
VOICE_TRACE_ENABLED=false
VOICE_TRACE_RETENTION_DAYS=7
# Production trace opt-in additionally requires all of the following:
# VOICE_TRACE_PRIVACY_APPROVED=true
# VOICE_TRACE_DESTINATION=
# VOICE_TRACE_ACCESS_ROLE=
# VOICE_TRACE_DELETION_MECHANISM=
# Only set true after the ElevenLabs account capability is verified.
ELEVENLABS_ZERO_RETENTION_VERIFIED=false
# Optional local provider endpoints for deterministic integration tests.
NAN_BASE_URL=https://api.nan.builders/v1
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
