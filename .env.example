# Model provider (OpenCode Go)
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=deepseek-v4-flash

# WDK demo configuration
WDK_WALLET_NAME=agent-demo
WDK_NETWORK=sepolia
WDK_TOKEN=USDT
# Optional for transfers; required for indexed history in live mode.
WDK_INDEXER_API_KEY=

# fixture | live — fixture is safe/default; live starts the bundled wdk-mcp process
WDK_TOOLS_SOURCE=fixture

# Required in live mode. Transfers fail closed if either policy value is absent or invalid.
# Use a positive plain-decimal cap and a comma-separated EVM recipient allowlist.
# WDK_MAX_TRANSFER_AMOUNT=0.05
# WDK_ALLOWED_RECIPIENTS=0x1111111111111111111111111111111111111111

# Optional. Live transfers poll this Sepolia JSON-RPC endpoint until the receipt is mined.
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# llm is the default conversational path (ToolLoopAgent). Set deterministic only for parser-only E2E.
AGENT_RUNTIME=llm

# comma-separated browser origins allowed for CORS
# CORS_ORIGINS=http://localhost:8083,http://127.0.0.1:8083

PORT=3000

# Speech-to-text (Whisper large-v3 via NaN Builders, https://nan.builders/docs)
NAN_API_KEY=
NAN_STT_MODEL=whisper

# Text-to-speech (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# Recipient address memory — disabled by default. Set all required values before enabling.
RECIPIENT_MEMORY_ENABLED=false
# App runtime uses the restricted role; admin URL is migration-only.
# DATABASE_URL=postgresql://recipient_app@127.0.0.1:5432/wdk_agent
# DATABASE_ADMIN_URL=postgresql://postgres@127.0.0.1:5432/wdk_agent
# Fixed demo tenant only; production must inject an authenticated principal instead.
# DEMO_USER_ID=11111111-1111-4111-8111-111111111111
RECIPIENT_MEMORY_MODEL_CACHE=.cache/recipient-memory-model
RECIPIENT_MEMORY_SCORE_THRESHOLD=0.78
RECIPIENT_MEMORY_SCORE_MARGIN=0.08
# JSON containing only records/facts already explicitly confirmed by the user.
# RECIPIENT_MEMORY_SEED_FILE=examples/recipient-memory.seed.json
RECIPIENT_MEMORY_SEED_FILE=
