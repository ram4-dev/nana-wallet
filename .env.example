# Nana Wallet — environment template.
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#
# This is the SINGLE configuration the app runs: Solana devnet through Privy
# with per-user wallets. There is no mode switch to set.
#
# Keys marked REQUIRED are referenced by `compose.privy-local.yaml` with
# `${VAR:?}`, so the stack refuses to start without them.
#
# Anything not listed here has a code default; see `src/config/`.

# ---------------------------------------------------------------------------
# Privy — identity, per-user wallets, and the signing sidecar
# ---------------------------------------------------------------------------

# REQUIRED. The Privy app that owns the users and their wallets.
PRIVY_APP_ID=
# REQUIRED. Server-side app secret. Never expose it to the browser.
PRIVY_APP_SECRET=
# REQUIRED. PEM public key used to verify Privy access tokens offline.
PRIVY_VERIFICATION_KEY=
# REQUIRED. Key quorum that authorizes the app to act on a user's wallet.
PRIVY_AUTHORIZATION_KEY_QUORUM_ID=
# REQUIRED. Public half of that quorum's authorization key.
PRIVY_AUTHORIZATION_PUBLIC_KEY=

# Optional. Override only for a non-production Privy API host.
# PRIVY_API_BASE_URL=
# Webhook signing secret, for the notifications webhook receipt.
# PRIVY_WEBHOOK_SECRET=

# The signing sidecar holds the authorization private key so no API or worker
# process ever reads it. Run it with `npm run signer:serve`.
# PRIVY_SIGNER_URL=http://127.0.0.1:8788/sign
# PRIVY_SIGNER_TOKEN=
# PRIVY_SIGNER_HOST=127.0.0.1
# PRIVY_SIGNER_PORT=8788
# PRIVY_SIGNER_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Wallet — Solana devnet
# ---------------------------------------------------------------------------

# The network drives chain routing. It must name Solana: any other value
# resolves an EVM wallet family and skips the Solana resolver.
WDK_NETWORK=solana-devnet
WDK_TOKEN=SOL
WDK_WALLET_NAME=privy-user

# ---------------------------------------------------------------------------
# LiveKit — the voice room
# ---------------------------------------------------------------------------

# REQUIRED. Server-side URL the backend uses to sign room tokens.
LIVEKIT_URL=
# REQUIRED.
LIVEKIT_API_KEY=
# REQUIRED.
LIVEKIT_API_SECRET=
# Browser-facing URL, when it differs from LIVEKIT_URL (for example a
# self-hosted server reached over the compose network).
# LIVEKIT_BROWSER_URL=
# LIVEKIT_AGENT_NAME=nani-agent
# LIVEKIT_ROOM_TOKEN_TTL=

# REQUIRED. Ed25519 pair that binds a voice session to a user. The private half
# stays server-side; rotate it if it is ever exposed.
LIVE_VOICE_BINDING_PUBLIC_KEY=
LIVE_VOICE_BINDING_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Agent — LLM and realtime voice
# ---------------------------------------------------------------------------

# REQUIRED. Realtime voice provider for the live agent.
OPENAI_API_KEY=
# REQUIRED. Text/LLM provider for the conversation agent.
OPENCODE_GO_API_KEY=
# OPENAI_REALTIME_MODEL=
# OPENAI_REALTIME_VOICE=
# OPENCODE_GO_BASE_URL=
# OPENCODE_GO_MODEL=
# AGENT_RUNTIME=llm

# ---------------------------------------------------------------------------
# Database and server
# ---------------------------------------------------------------------------

# Required for the conversation, grant, and recipient-memory storage.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/wdk_agent?options=-csearch_path%3Dpublic,extensions
# CORS_ORIGINS=https://nana-privy.localhost
# HOST=0.0.0.0
# PORT=3000
# NODE_ENV=development

# ---------------------------------------------------------------------------
# Recipient memory (needs DATABASE_URL)
# ---------------------------------------------------------------------------

# RECIPIENT_MEMORY_ENABLED=true
# RECIPIENT_MEMORY_SEED_FILE=examples/recipient-memory.seed.json
# RECIPIENT_MEMORY_MODEL_CACHE=.cache/recipient-memory-model
# RECIPIENT_MEMORY_SCORE_THRESHOLD=0.78
# RECIPIENT_MEMORY_SCORE_MARGIN=0.08
# RECIPIENT_MEMORY_SCORE_FLOOR=0.55

# ---------------------------------------------------------------------------
# Privacy and observability (defaults are safe; enable deliberately)
# ---------------------------------------------------------------------------

# VOICE_TRACE_ENABLED=false
# VOICE_TRACE_RETENTION_DAYS=7
# LIVEKIT_RECORDING_ENABLED=false
# AGENT_OBSERVABILITY_RECORDING=false
